# ローカル開発用
# このファイルを .env にコピーして使用してください:
#   cp .env.example .env

# DB (docker compose が自動で起動する PostgreSQL に接続)
DATABASE_URL="postgresql://salon:salon@db:5432/salon_dev"

# セッション署名キー (開発用固定値)
SESSION_SECRET="dev-secret-change-me-please-32chars-min"

# メール送信 (空のままでOK: 認証コードは画面に直接表示されます)
RESEND_API_KEY=""

# Stripe (空のままでOK: 決済をスキップして直接入会できます)
# 実際の Stripe Checkout を試したい場合のみテストキーをセット
STRIPE_SECRET_KEY=""
